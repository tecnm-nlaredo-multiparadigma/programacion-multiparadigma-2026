{
  "name": "taller-despacho",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "condicionales": "tsx src/condicionales.ts",
    "despacho": "tsx src/demo.ts",
    "fragmentos": "tsx fragmentos/tabla.ts",
    "fragmento4": "tsc --noEmit -p fragmentos",
